@model VisualizarFornecedorViewModel

@{
    ViewBag.Titulo = "Excluir Fornecedor";
}

<div class="card border-danger shadow-sm">

    <div class="card-header bg-danger text-white">

        <h3>@ViewBag.Titulo</h3>

    </div>

    <div class="card-body">

        <p class="fs-5">

            Deseja realmente excluir o fornecedor abaixo?

        </p>

        <hr />

        <dl class="row">

            <dt class="col-sm-3">
                Nome
            </dt>

            <dd class="col-sm-9">
                @Model.Nome
            </dd>

            <dt class="col-sm-3">
                Telefone
            </dt>

            <dd class="col-sm-9">
                @Model.Telefone
            </dd>

            <dt class="col-sm-3">
                CNPJ
            </dt>

            <dd class="col-sm-9">
                @Model.Cnpj
            </dd>

        </dl>

        <form asp-action="ConfirmarExclusao"
              method="post">

            <input type="hidden"
                   name="id"
                   value="@Model.Id" />

            <div class="d-flex gap-2">

                <button type="submit"
                        class="btn btn-danger">

                    Confirmar Exclusão

                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">

                    Cancelar

                </a>

            </div>

        </form>

    </div>

</div>