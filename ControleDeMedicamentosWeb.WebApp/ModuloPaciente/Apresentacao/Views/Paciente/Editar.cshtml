@model EditarPacienteViewModel

@{
    ViewBag.Titulo = "Editar Paciente";
}

<div class="card shadow-sm">

    <div class="card-header">

        <h3>@ViewBag.Titulo</h3>

    </div>

    <div class="card-body">

        <form method="post">

            <input asp-for="Id" type="hidden" />

            <div asp-validation-summary="All"
                 class="text-danger mb-3">
            </div>

            <div class="mb-3">

                <label asp-for="Nome"
                       class="form-label">
                </label>

                <input asp-for="Nome"
                       class="form-control" />

                <span asp-validation-for="Nome"
                      class="text-danger">
                </span>

            </div>

            <div class="mb-3">

                <label asp-for="Telefone"
                       class="form-label">
                </label>

                <input asp-for="Telefone"
                       class="form-control" />

                <span asp-validation-for="Telefone"
                      class="text-danger">
                </span>

            </div>

            <div class="mb-3">

                <label asp-for="CartaoSus"
                       class="form-label">
                </label>

                <input asp-for="CartaoSus"
                       class="form-control" />

                <span asp-validation-for="CartaoSus"
                      class="text-danger">
                </span>

            </div>

            <div class="mb-3">

                <label asp-for="Cpf"
                       class="form-label">
                </label>

                <input asp-for="Cpf"
                       class="form-control" />

                <span asp-validation-for="Cpf"
                      class="text-danger">
                </span>

            </div>

            <div class="d-flex gap-2">

                <button type="submit"
                        class="btn btn-primary">

                    Salvar

                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">

                    Voltar

                </a>

            </div>

        </form>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}