@model CadastrarFuncionarioViewModel

@{
    ViewBag.Titulo = "Cadastrar Funcionário";
}

<div class="card shadow-sm">

    <div class="card-header">

        <h3>@ViewBag.Titulo</h3>

    </div>

    <div class="card-body">

        <form method="post">

            <div asp-validation-summary="All"
                 class="text-danger mb-3">
            </div>

            <div class="mb-3">

                <label asp-for="Nome"
                       class="form-label">
                </label>

                <input asp-for="Nome"
                       class="form-control" />

                <span asp-validation-for="Nome"
                      class="text-danger">
                </span>

            </div>

            <div class="mb-3">

                <label asp-for="Telefone"
                       class="form-label">
                </label>

                <input asp-for="Telefone"
                       class="form-control" />

                <span asp-validation-for="Telefone"
                      class="text-danger">
                </span>

            </div>

            <div class="mb-3">

                <label asp-for="CPF"
                       class="form-label">
                </label>

                <input asp-for="CPF"
                       class="form-control" />

                <span asp-validation-for="CPF"
                      class="text-danger">
                </span>

            </div>

            <button type="submit"
                    class="btn btn-primary">

                Salvar

            </button>

            <a asp-action="Index"
               class="btn btn-secondary">

                Voltar

            </a>

        </form>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}