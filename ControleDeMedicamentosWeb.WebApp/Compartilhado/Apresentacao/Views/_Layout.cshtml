<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>
        @(ViewBag.Titulo ?? "Controle de Medicamentos")
    </title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" />
</head>
<body>

    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">

        <div class="container">

            <a class="navbar-brand"
               asp-controller="Fornecedor"
               asp-action="Index">

                Controle de Medicamentos

            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#menu">

                <span class="navbar-toggler-icon"></span>

            </button>

            <div class="collapse navbar-collapse"
                 id="menu">

                <ul class="navbar-nav me-auto">

                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="Fornecedor"
                           asp-action="Index">

                            Fornecedores

                        </a>

                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                        asp-controller="Paciente"
                        asp-action="Index">
                        
                            Pacientes
                        </a>
                        
                    </li>

                    <li class="nav-item">

                    <a class="nav-link"
                    asp-controller="Medicamento"
                    asp-action="Index">

                        Medicamentos

                    </a>

                    </li>

                    <li class="nav-item">

                    <a class="nav-link"
                    asp-controller="Funcionario"
                    asp-action="Index">

                    Funcionários

                     </a>

                    </li>

                    <li class="nav-item">

                    <a class="nav-link"
                    asp-controller="RequisicaoEntrada"
                    asp-action="Index">

                    Entradas

                    </a>

                    </li>

                </ul>

            </div>

        </div>

    </nav>

    <main class="container mt-4">

        @if (TempData["Sucesso"] is not null)
        {
            <div class="alert alert-success alert-dismissible fade show">

                @TempData["Sucesso"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>

            </div>
        }

        @if (TempData["Erro"] is not null)
        {
            <div class="alert alert-danger alert-dismissible fade show">

                @TempData["Erro"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>

            </div>
        }

        @RenderBody()

    </main>

    <footer class="border-top mt-5 py-3">

        <div class="container text-center">

            <span class="text-muted">

                Controle de Medicamentos Web - 2026

            </span>

        </div>

    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js">
    </script>

    @await RenderSectionAsync(
        "Scripts",
        required: false)

</body>
</html>