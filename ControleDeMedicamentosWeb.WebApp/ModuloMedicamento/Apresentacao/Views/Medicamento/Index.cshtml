@model List<VisualizarMedicamentoViewModel>

@{
    ViewBag.Titulo = "Medicamentos";
}

<div class="d-flex justify-content-between align-items-center mb-3">

    <h2>@ViewBag.Titulo</h2>

    <a asp-action="Cadastrar"
       class="btn btn-primary">

        <i class="bi bi-plus-circle"></i>
        Novo Medicamento

    </a>

</div>

<div class="card shadow-sm">

    <div class="card-body">

        <table class="table table-hover table-striped align-middle">

            <thead>

                <tr>
                    <th>Nome</th>
                    <th>Descrição</th>
                    <th>Fornecedor</th>
                    <th>Estoque</th>
                    <th>Status</th>
                    <th width="180">Ações</th>
                </tr>

            </thead>

            <tbody>

                @foreach (var medicamento in Model)
                {
                    <tr>

                        <td>@medicamento.Nome</td>

                        <td>@medicamento.Descricao</td>

                        <td>@medicamento.NomeFornecedor</td>

                        <td>@medicamento.QuantidadeEstoque</td>

                        <td>

                            @if (medicamento.EmFalta)
                            {
                                <span class="badge bg-danger">
                                    EM FALTA
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success">
                                    DISPONÍVEL
                                </span>
                            }

                        </td>

                        <td>

                            <a asp-action="Editar"
                               asp-route-id="@medicamento.Id"
                               class="btn btn-warning btn-sm">

                                <i class="bi bi-pencil"></i>

                            </a>

                            <a asp-action="Excluir"
                               asp-route-id="@medicamento.Id"
                               class="btn btn-danger btn-sm">

                                <i class="bi bi-trash"></i>

                            </a>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>